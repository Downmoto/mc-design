{
  "name": "@memorycore/design",
  "version": "0.0.0",
  "description": "Shared Svelte design tokens and components for MemoryCore products",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Downmoto/mc-design.git"
  },
  "engines": {
    "node": ">=22.17",
    "npm": ">=11"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "docs",
    "FONT-LICENSES.md"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.css": "./dist/generated/tokens.css",
    "./tokens": {
      "types": "./dist/generated/tokens.d.ts",
      "default": "./dist/generated/tokens.js"
    }
  },
  "scripts": {
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "build": "npm run tokens:generate && svelte-package",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run tokens:check && npm run format:check && npm run typecheck && npm test && npm run build && npm run tokens:check"
  },
  "peerDependencies": {
    "svelte": ">=5.57.1 <6"
  },
  "dependencies": {
    "@fontsource/manufacturing-consent": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
